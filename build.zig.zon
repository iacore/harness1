.{
    .name = .run1,
    .version = "0.0.0",
    // Generated when the package was created, and never changed: it is what
    // makes one package unambiguously an update of another. Editing it has
    // security and trust implications.
    .fingerprint = 0x18e85ba3defaaa68,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{},
    // What the package hash covers, and so all that a consumer of it receives:
    // what it takes to compile, plus the licence and the per-model notes under
    // `core/remote/` that a user of the client reads. Developer-only source is
    // left out — the research programs under `research`, the Python
    // scratch client under `research/python`, and `build.research.zig`, which drives
    // them. The program under `ui` is developer-only as well. `core/` is named
    // file by file: every file the library reaches must be listed here, and
    // `zig build test` enforces that by rebuilding the package from this list.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "COPYING.md",
        "core/root.zig",
        "core/curl.zig",
        "core/curl_shim.c",
        "core/json_encoder.zig",
        "core/omp_features.zig",
        "core/turns.zig",
        "core/system_prompt.zig",
        "core/debug.zig",
        "core/remote",
    },
}